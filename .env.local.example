NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
UPSTASH_REDIS_KV_REST_API_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_KV_REST_API_TOKEN=your_upstash_redis_rest_token

# Spotify playlist sync (optional — app works without these)
SPOTIFY_CLIENT_ID=your_spotify_app_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_app_client_secret
SPOTIFY_REFRESH_TOKEN=your_refresh_token_from_setup_flow
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id

# Email notifications on new nodes (optional — app works without these)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Music Blockchain <notifications@yourdomain.com>
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
